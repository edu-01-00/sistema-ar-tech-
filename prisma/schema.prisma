// Sistema de Gestão de Laboratório - schema de banco de dados
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contador genérico usado para gerar códigos únicos e sequenciais
// (ex: código de parâmetro de ensaio, código de ordem de serviço de EPI,
// numeração anual do Processo Produtivo — chave "PP_<ano>").
// O incremento é feito com UPSERT atômico (ver src/lib/services/sequence.ts),
// seguro contra concorrência.
model Sequence {
  key        String @id
  lastNumber Int    @default(0)

  @@map("sequences")
}

// =========================================================================
// AUTENTICAÇÃO / PERMISSÕES
// =========================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // roles de sistema (ADMIN) não podem ser excluídas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // ex: "clients.create"
  description String
  module      String // agrupamento para exibição na UI (ex: "clients")
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Permite conceder ou revogar uma permissão específica para um usuário,
// sobrepondo o que vem do papel (role) dele.
model UserPermission {
  userId       String
  permissionId String
  granted      Boolean // true = concede, false = revoga explicitamente
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  active       Boolean   @default(true)
  employeeId   String?   @unique
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role            Role             @relation(fields: [roleId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  userPermissions UserPermission[]

  uploadedCompanyDocuments      CompanyDocument[]
  uploadedEmployeeDocuments     EmployeeDocument[]
  createdEpiOrders              EpiOrder[]
  createdEpiRecords             EpiRecord[]
  createdProductiveProcesses    ProductiveProcess[]     @relation("ProductiveProcessCreatedBy")
  createdServiceOrders          ServiceOrder[]          @relation("ServiceOrderCreatedBy")
  createdSamplingPlans          SamplingPlan[]          @relation("SamplingPlanCreatedBy")
  fieldResponsibleSamplingPlans SamplingPlan[]          @relation("SamplingPlanFieldResponsible")
  receivedCustodyEntries        CustodyEntry[]
  acceptedSampleAcceptances     SampleAcceptance[]
  analyzedResultWorksheets      ResultWorksheet[]       @relation("ResultWorksheetAnalyzedBy")
  validatedResultWorksheets     ResultWorksheet[]       @relation("ResultWorksheetValidatedBy")
  createdProposals              Proposal[]              @relation("ProposalCreatedBy")
  criticalAnalysisProposals     Proposal[]              @relation("ProposalCriticalAnalysisBy")
  proposalStatusChanges         ProposalStatusHistory[]
  auditLogs                     AuditLog[]
  updatedTechnicalTexts         TechnicalText[]
  updatedProposalTextTemplates  ProposalTextTemplate[]

  @@map("users")
}

// =========================================================================
// EMPRESA
// =========================================================================

enum ProfessionalRegistrationType {
  CRQ
  CREA
}

model Company {
  id                String   @id @default(cuid())
  name              String
  cnpj              String   @unique
  email             String
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      String?
  addressZipCode    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Logomarca da empresa: usada na Ordem de Serviço de EPI e em propostas.
  logoStorageKey String?
  logoFileName   String?
  logoMimeType   String?

  // Dados bancários: usados automaticamente na proposta quando a forma de
  // pagamento escolhida for Depósito/PIX, evitando digitação manual.
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  bankAccountType String?
  bankPixKey      String?

  // Registro profissional (opcional, não obrigatório no cadastro).
  professionalRegistrationType   ProfessionalRegistrationType?
  professionalRegistrationNumber String?

  documents CompanyDocument[]

  @@map("companies")
}

model CompanyDocument {
  id           String   @id @default(cuid())
  companyId    String
  fileName     String
  storageKey   String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@map("company_documents")
}

// =========================================================================
// FUNCIONÁRIOS
// =========================================================================

model Employee {
  id                 String    @id @default(cuid())
  name               String
  cpf                String?   @unique
  email              String?
  phone              String?
  position           String? // cargo/função
  sector             String? // setor
  registrationNumber String? // número de registro do funcionário
  hiredAt            DateTime?
  terminatedAt       DateTime? // data de demissão — preenchida ao desativar o funcionário
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user      User?
  documents EmployeeDocument[]
  epiOrders EpiOrder[]
  epiRecord EpiRecord?

  @@map("employees")
}

enum EmployeeDocumentCategory {
  CONTRATACAO
  SEGURANCA_TRABALHO
  CURSO
  EXAME
  OUTRO
}

model EmployeeDocument {
  id           String                   @id @default(cuid())
  employeeId   String
  category     EmployeeDocumentCategory
  fileName     String
  storageKey   String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime                 @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@map("employee_documents")
}

// =========================================================================
// EPI / ORDEM DE SERVIÇO
// =========================================================================

model Epi {
  id          String   @id @default(cuid())
  name        String
  ca          String? // certificado de aprovação
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems EpiOrderItem[]

  @@map("epi")
}

enum EpiOrderStatus {
  PENDENTE
  ACEITO
}

model EpiOrder {
  id           String         @id @default(cuid())
  code         String         @unique
  employeeId   String
  status       EpiOrderStatus @default(PENDENTE)
  issuedAt     DateTime       @default(now())
  acceptedAt   DateTime?
  acceptedName String? // nome digitado no aceite (declaração de concordância)
  storageKey   String? // PDF gerado
  createdById  String
  createdAt    DateTime       @default(now())

  // Atividades a serem realizadas: texto livre específico desta OS (não
  // confundir com o cargo/função do cadastro do funcionário).
  activities String?

  // Snapshot do setor/cargo do funcionário no momento da emissão: uma
  // alteração posterior no cadastro do funcionário nunca deve mudar uma OS
  // já emitida (mesmo padrão de snapshot já usado em EpiOrderItem.nameSnapshot).
  sectorSnapshot   String?
  positionSnapshot String?

  employee  Employee       @relation(fields: [employeeId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     EpiOrderItem[]

  @@map("epi_orders")
}

model EpiOrderItem {
  id           String @id @default(cuid())
  epiOrderId   String
  epiId        String
  nameSnapshot String

  epiOrder EpiOrder @relation(fields: [epiOrderId], references: [id], onDelete: Cascade)
  epi      Epi      @relation(fields: [epiId], references: [id])

  @@map("epi_order_items")
}

// =========================================================================
// FICHA DE EPI
// =========================================================================

// Ficha de EPI: um único registro por funcionário (não um por entrega, como
// a Ordem de Serviço de EPI acima). Assinada uma única vez, na admissão —
// os EPIs entregues depois são adicionados como itens (EpiRecordItem), sem
// exigir nova assinatura a cada entrega. Data de admissão/demissão nunca
// são duplicadas aqui: sempre lidas do cadastro do funcionário (Employee)
// no momento da exibição/geração do PDF.
model EpiRecord {
  id          String    @id @default(cuid())
  employeeId  String    @unique
  signedAt    DateTime?
  signedName  String? // nome digitado na assinatura (mesmo padrão já usado em EpiOrder.acceptedName)
  storageKey  String? // último PDF gerado
  createdById String
  createdAt   DateTime  @default(now())

  employee  Employee        @relation(fields: [employeeId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  items     EpiRecordItem[]

  @@map("epi_records")
}

// Item de EPI entregue: descrição/quantidade/Nº do CA em texto livre
// (conforme item 6-8 do requisito — não vinculado ao catálogo de Epi usado
// pela Ordem de Serviço, que é um fluxo separado), com datas de entrega e
// devolução próprias e independentes para cada equipamento.
model EpiRecordItem {
  id          String    @id @default(cuid())
  epiRecordId String
  description String
  quantity    Int
  caNumber    String?
  deliveredAt DateTime
  returnedAt  DateTime?
  // Assinatura digital do funcionário confirmando o recebimento DESTE EPI
  // especificamente — distinta da assinatura única da ficha (EpiRecord.signedAt),
  // que representa a ciência do termo de compromisso geral na admissão.
  signedName  String?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())

  epiRecord EpiRecord @relation(fields: [epiRecordId], references: [id], onDelete: Cascade)

  @@map("epi_record_items")
}

// =========================================================================
// UNIDADES DE MEDIDA (catálogo centralizado)
// =========================================================================

// Catálogo único de unidades de medida, usado tanto no cadastro de Ensaios
// quanto no de Legislação (select, não mais texto livre). Uma unidade
// cadastrada aqui fica disponível automaticamente nos dois lugares.
model MeasurementUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("measurement_units")
}

// =========================================================================
// ENSAIOS / LEGISLAÇÃO
// =========================================================================

enum TestMatrix {
  EMISSOES_ATMOSFERICAS
  QUALIDADE_AR
  RUIDO_AMBIENTAL
}

model Test {
  id                  String     @id @default(cuid())
  name                String
  method              String
  cas                 String?
  quantificationLimit String?
  isSubcontracted     Boolean    @default(false)
  isAccredited        Boolean    @default(false)
  unit                String
  parameterCode       String     @unique
  value               Decimal    @db.Decimal(12, 2)
  matrix              TestMatrix
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  legislationTests     LegislationTest[]
  collectionPointTests CollectionPointTest[]
  proposalTests        ProposalTest[]

  @@map("tests")
}

model Legislation {
  id               String   @id @default(cuid())
  name             String
  description      String?
  item             String?
  frameworkProcess String? // processo de enquadramento
  allowedLimit     String?
  unit             String?
  corrections      String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  legislationTests            LegislationTest[]
  collectionPointLegislations CollectionPointLegislation[]

  @@map("legislations")
}

model LegislationTest {
  legislationId String
  testId        String

  legislation Legislation @relation(fields: [legislationId], references: [id], onDelete: Cascade)
  test        Test        @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([legislationId, testId])
  @@map("legislation_tests")
}

// =========================================================================
// CLIENTES
// =========================================================================

model Client {
  id                String  @id @default(cuid())
  cnpj              String  @unique
  corporateName     String // razão social
  tradeName         String? // nome fantasia
  email             String?
  phone             String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      String?
  addressZipCode    String?

  // Cadastro do cliente: dados complementares.
  mainActivity      String? // atividade principal
  activityStartDate DateTime? // data do início da atividade
  stateRegistration String? // inscrição estadual
  licenseNumber     String? // número da licença/certidão

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts         ClientContact[]
  collectionPoints CollectionPoint[]
  proposals        Proposal[]

  @@map("clients")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String? // cargo do contato
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposalContacts ProposalContact[]

  @@map("client_contacts")
}

// =========================================================================
// PONTOS DE COLETA
// =========================================================================

model CollectionPoint {
  id        String     @id @default(cuid())
  clientId  String
  matrix    TestMatrix
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  airQualityDetail            CollectionPointAirQuality?
  atmosphericDetail           CollectionPointAtmosphericEmission?
  noiseDetail                 CollectionPointNoise?
  collectionPointTests        CollectionPointTest[]
  collectionPointLegislations CollectionPointLegislation[]
  proposalCollectionPoints    ProposalCollectionPoint[]
  ProposalTest                ProposalTest[]
  productiveProcesses         ProductiveProcess[]

  @@map("collection_points")
}

// Campos específicos da matriz "Qualidade do ar".
model CollectionPointAirQuality {
  collectionPointId       String  @id
  location                String? // local da coleta
  gpsLatitude             String?
  gpsLongitude            String?
  mapsLink                String? // link do Google Maps/Earth
  surroundingsDescription String? // descrição do entorno (solo, construções, rodovias, empresas)
  knownSamplingDeviation  String? // desvio da amostragem conhecido

  // Imagem da localização do ponto (upload persistente, JPG).
  imageStorageKey String?
  imageFileName   String?
  imageMimeType   String?

  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)

  @@map("collection_point_air_quality")
}

enum ChimneyInstallationYear {
  ANTERIOR_2007
  POSTERIOR_2007
}

enum ChimneyAccessType {
  PLATAFORMA_FIXA
  PLATAFORMA_ELEVATORIA
  SOLO
  CAMINHAO_MUNCK
  TELHADO
}

enum ChimneyCoverage {
  COBERTO
  DESCOBERTO
}

enum ChimneyGeometry {
  RETANGULAR
  CIRCULAR
  QUADRADA
}

enum AtmosphericEmissionType {
  COMBUSTAO
  PROCESSO
  NAO_APLICADO
}

enum AtmosphericCombustionType {
  EXTERNA
  NAO_EXTERNA
  NAO_APLICADO
}

enum OperationalCycle {
  CONTINUO
  NAO_CONTINUO
}

enum FuelConsumptionUnit {
  L_H
  M3_H
  KG_H
}

// Campos específicos da matriz "Emissões atmosféricas" (todos opcionais).
model CollectionPointAtmosphericEmission {
  collectionPointId String  @id
  notes             String?
  extraData         Json?

  // Campos de seleção
  installationYear ChimneyInstallationYear?
  accessType       ChimneyAccessType?
  coverage         ChimneyCoverage?
  chimneyGeometry  ChimneyGeometry?
  emissionType     AtmosphericEmissionType?
  combustionType   AtmosphericCombustionType?
  operationalCycle OperationalCycle?

  // Campos de texto livre
  geographicCoordinates           String?
  processDescription              String?
  rawMaterialsAndQuantities       String?
  productsAndQuantities           String?
  operatingDaysAndHours           String?
  operatingConditions             String?
  internalEquivalentDuctDiameterM String?
  upstreamDistanceM               String?
  downstreamDistanceM             String?
  internalLengthM                 String?
  internalWidthM                  String?
  flangeSleeveCm                  String?
  wallThicknessCm                 String?
  totalChimneyLengthM             String?
  totalChimneyLengthToGroundM     String?
  fuel                            String?
  fuelConsumption                 String?
  fuelConsumptionUnit             FuelConsumptionUnit?
  nominalPowerMw                  String?
  pollutionControlType            String?
  samplingDeviations              String?

  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)

  @@map("collection_point_atmospheric_emission")
}

// Campos específicos da matriz "Ruído" (mesma estrutura de Qualidade do Ar,
// conforme item 10 do requisito).
model CollectionPointNoise {
  collectionPointId       String  @id
  notes                   String?
  extraData               Json?
  gpsLatitude             String?
  gpsLongitude            String?
  mapsLink                String?
  surroundingsDescription String?
  knownSamplingDeviation  String?

  imageStorageKey String?
  imageFileName   String?
  imageMimeType   String?

  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)

  @@map("collection_point_noise")
}

model CollectionPointTest {
  collectionPointId String
  testId            String

  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  test            Test            @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([collectionPointId, testId])
  @@map("collection_point_tests")
}

model CollectionPointLegislation {
  collectionPointId String
  legislationId     String

  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  legislation     Legislation     @relation(fields: [legislationId], references: [id], onDelete: Cascade)

  @@id([collectionPointId, legislationId])
  @@map("collection_point_legislations")
}

// =========================================================================
// PROPOSTAS
// =========================================================================

enum ProposalStatus {
  EM_ELABORACAO
  ENVIADA
  APROVADA
  NAO_APROVADA
  CANCELADA
}

enum PaymentMethod {
  A_VISTA
  PARCELADO
  BOLETO
  DEPOSITO_PIX
}

// Prazo de vencimento/pagamento. Estrutura em enum para permitir adicionar
// novas condições futuramente com uma migration incremental.
enum PaymentTermOption {
  DIAS_15
  DIAS_30
  DIAS_15_30
  DIAS_30_60_90
}

// Controla a numeração sequencial anual do código da proposta (PR-001/2026).
// Atualizado dentro de uma transação com lock de linha para evitar
// concorrência (dois usuários criando proposta ao mesmo tempo).
model ProposalSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("proposal_sequences")
}

model Proposal {
  id             String         @id @default(cuid())
  code           String         @unique // ex: PR-001/2026-R00
  sequenceNumber Int
  year           Int
  revision       Int            @default(0)
  rootId         String // agrupa todas as revisões da mesma proposta original
  supersededAt   DateTime? // preenchido quando uma revisão mais nova é criada
  status         ProposalStatus @default(EM_ELABORACAO)

  clientId                String
  paymentMethod           PaymentMethod?
  installments            Int?
  paymentTerm             PaymentTermOption? // legado — substituído por paymentDueDays/firstInstallmentDueDays
  // Dias para vencimento (à vista/boleto/depósito-pix): texto gerado dinamicamente.
  paymentDueDays          Int?
  // Vencimento da 1ª parcela em dias (parcelado: 15 ou 30) — as demais vencem
  // a cada 30 dias a partir dela, calculado dinamicamente.
  firstInstallmentDueDays Int?
  additionalInfo          String?

  // Item 15: exibir ou não o valor unitário no documento gerado. O valor
  // é SEMPRE usado internamente no cálculo do total, independente disso.
  exhibitUnitValue   Boolean @default(true)
  // Item 16: exibir (e usar) a seção de custos adicionais no total.
  // O cálculo do total dos ensaios nunca é afetado por esta opção.
  useAdditionalCosts Boolean @default(true)
  // Exibir ou não a linha de deslocamento no Resumo Comercial. O valor do
  // deslocamento continua sendo somado ao total independente desta opção.
  exhibitTravelValue Boolean @default(true)

  // Item 24-28: quais blocos de "Observações importantes" aparecem no
  // documento gerado (nenhum, um, dois ou os três podem ser selecionados).
  observationEmissoesAtmosfericas Boolean @default(false)
  observationQualidadeAr          Boolean @default(false)
  observationRuido                Boolean @default(false)

  // Item 32-33: análise crítica/confirmação da proposta antes do envio.
  // Os 4 itens são selecionáveis individualmente na tela (fase final da
  // elaboração), mas NÃO aparecem no PDF gerado — apenas o resultado
  // (quem/quando) alimenta "Responsáveis pela Proposta".
  criticalAnalysisReq1      Boolean   @default(false)
  criticalAnalysisReq2      Boolean   @default(false)
  criticalAnalysisReq3      Boolean   @default(false)
  criticalAnalysisReq4      Boolean   @default(false)
  criticalAnalysisConfirmed Boolean   @default(false)
  criticalAnalysisById      String?
  criticalAnalysisAt        DateTime?

  travelDistanceKm Decimal? @db.Decimal(10, 2)
  travelValuePerKm Decimal? @db.Decimal(10, 2)
  travelOtherCosts Decimal? @db.Decimal(12, 2)
  travelTotalValue Decimal? @db.Decimal(12, 2)

  testsTotal      Decimal @default(0) @db.Decimal(12, 2)
  otherCostsTotal Decimal @default(0) @db.Decimal(12, 2)
  // Desconto percentual aplicado sobre o valor-base da proposta (ensaios +
  // custos adicionais + deslocamento, sempre — item 8 do requisito de
  // desconto). discountValue é o valor calculado e persistido, no mesmo
  // padrão já usado para os demais totais (recalculado a cada alteração).
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountValue   Decimal @default(0) @db.Decimal(12, 2)
  totalValue      Decimal @default(0) @db.Decimal(12, 2)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client             Client @relation(fields: [clientId], references: [id])
  createdBy          User   @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  criticalAnalysisBy User?  @relation("ProposalCriticalAnalysisBy", fields: [criticalAnalysisById], references: [id])

  matrices            ProposalMatrix[]
  contacts            ProposalContact[]
  collectionPoints    ProposalCollectionPoint[]
  tests               ProposalTest[]
  costs               ProposalCost[]
  texts               ProposalText[]
  textSnapshots       ProposalTextSnapshot[]
  statusHistory       ProposalStatusHistory[]
  productiveProcesses ProductiveProcess[]

  @@unique([sequenceNumber, year, revision])
  @@index([rootId])
  @@index([clientId])
  @@map("proposals")
}

model ProposalMatrix {
  proposalId String
  matrix     TestMatrix

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@id([proposalId, matrix])
  @@map("proposal_matrices")
}

model ProposalContact {
  proposalId      String
  clientContactId String

  proposal      Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientContact ClientContact @relation(fields: [clientContactId], references: [id])

  @@id([proposalId, clientContactId])
  @@map("proposal_contacts")
}

model ProposalCollectionPoint {
  proposalId        String
  collectionPointId String

  proposal        Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id])

  @@id([proposalId, collectionPointId])
  @@map("proposal_collection_points")
}

// Snapshot do ensaio no momento da proposta: alterar o valor aqui NUNCA
// altera o cadastro geral do ensaio (Test.value permanece intocado).
model ProposalTest {
  id                String @id @default(cuid())
  proposalId        String
  testId            String
  collectionPointId String

  nameSnapshot   String
  methodSnapshot String
  unitSnapshot   String
  codeSnapshot   String
  valueSnapshot  Decimal @db.Decimal(12, 2)
  quantity       Int     @default(1)

  proposal          Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  test              Test               @relation(fields: [testId], references: [id])
  collectionPoint   CollectionPoint    @relation(fields: [collectionPointId], references: [id])
  serviceOrderItems ServiceOrderItem[]

  @@map("proposal_tests")
}

enum ProposalCostType {
  ART
  OUTRO
}

model ProposalCost {
  id          String           @id @default(cuid())
  proposalId  String
  description String
  value       Decimal          @db.Decimal(12, 2)
  type        ProposalCostType @default(OUTRO)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_costs")
}

// Snapshot editável do texto técnico por matriz, copiado de TechnicalText
// quando a matriz é selecionada na proposta, podendo ser editado por proposta.
model ProposalText {
  id         String     @id @default(cuid())
  proposalId String
  matrix     TestMatrix
  content    String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, matrix])
  @@map("proposal_texts")
}

model ProposalStatusHistory {
  id          String         @id @default(cuid())
  proposalId  String
  status      ProposalStatus
  changedById String
  createdAt   DateTime       @default(now())

  proposal  Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@map("proposal_status_history")
}

// Categorias de textos padrão administráveis da proposta (item 35).
// OBSERVACAO_IMPORTANTE usa o campo `matrix` para diferenciar os 3 blocos;
// as demais categorias têm um único registro (matrix nulo).
enum ProposalTextCategory {
  FORMA_PAGAMENTO_30
  FORMA_PAGAMENTO_15_30
  DECLARACAO_CONFORMIDADE
  VALIDADE_PROPOSTA
  PRAZO_ENTREGA_RELATORIO
  OBSERVACAO_IMPORTANTE
  PROTECAO_PROPRIEDADE_CLIENTE
  CONFIRMACAO_PROPOSTA
  OUTRAS_INFORMACOES
}

// Texto padrão administrável, editável por usuários autorizados (item 36).
// Alterar um texto padrão aqui NUNCA altera propostas já emitidas — o
// conteúdo é copiado para ProposalTextSnapshot no momento da criação,
// seguindo o mesmo padrão já usado por TechnicalText/ProposalText.
model ProposalTextTemplate {
  id          String               @id @default(cuid())
  category    ProposalTextCategory
  name        String
  content     String
  matrix      TestMatrix? // usado somente em OBSERVACAO_IMPORTANTE
  active      Boolean              @default(true)
  order       Int                  @default(0)
  updatedById String?
  updatedBy   User?                @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime             @updatedAt
  createdAt   DateTime             @default(now())

  @@unique([category, matrix])
  @@map("proposal_text_templates")
}

// Snapshot imutável do texto padrão no momento em que a proposta foi criada
// (ou em que o texto foi selecionado). Editar o ProposalTextTemplate depois
// não afeta propostas já existentes.
model ProposalTextSnapshot {
  id         String               @id @default(cuid())
  proposalId String
  category   ProposalTextCategory
  matrix     TestMatrix?
  name       String
  content    String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, category, matrix])
  @@map("proposal_text_snapshots")
}

// Texto técnico "base" administrável por matriz, usado como ponto de
// partida ao montar uma nova proposta (depois copiado para ProposalText).
model TechnicalText {
  id          String     @id @default(cuid())
  matrix      TestMatrix @unique
  title       String
  content     String
  updatedById String?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("technical_texts")
}

// =========================================================================
// PROCESSO PRODUTIVO / ORDEM DE SERVIÇO
// =========================================================================

enum ProductiveProcessStatus {
  PLANEJADO
  AGENDADO
  EM_CAMPO
  RECEBIDO_CUSTODIA
  EM_ANALISE
  VALIDADO
  REJEITADO
  CANCELADO
}

// Processo Produtivo: gerado para UM ponto de coleta da proposta — e, desde
// a Campanha de Monitoramento, criado AUTOMATICAMENTE (junto com sua Ordem
// de Serviço) para cada ponto de coleta assim que a proposta é aprovada
// (changeProposalStatus), além de poder ser gerado manualmente como antes.
// Uma proposta com vários pontos sempre tem um Processo Produtivo por ponto.
// Como cada CollectionPoint pertence a uma única matriz, o Processo
// Produtivo é também, na prática, o "item de execução" por matriz/ponto —
// é nele que pendura o ciclo de vida técnico (Plano de Amostragem, Entrada
// e Custódia, Checagem/Aceitação, Resultados) exigido pela ISO/IEC 17025.
// Numeração sequencial anual (PP 001/2026), reaproveitando o contador
// genérico `Sequence` (chave "PP_<ano>"), reiniciada a cada novo ano.
model ProductiveProcess {
  id             String                  @id @default(cuid())
  code           String                  @unique // ex: "PP 001/2026"
  sequenceNumber Int
  year           Int
  status         ProductiveProcessStatus @default(PLANEJADO)

  proposalId        String
  collectionPointId String

  // Controla a numeração das Ordens de Serviço geradas a partir deste
  // Processo Produtivo (OS 001/2026_1, _2, ...). Incrementado atomicamente
  // via UPDATE ... RETURNING (mesmo padrão de proposalDetailInclude /
  // allocateSequenceNumber em proposal-service.ts).
  lastServiceOrderNumber Int @default(0)

  createdById String
  createdAt   DateTime @default(now())

  proposal        Proposal        @relation(fields: [proposalId], references: [id])
  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id])
  createdBy       User            @relation("ProductiveProcessCreatedBy", fields: [createdById], references: [id])
  serviceOrders   ServiceOrder[]

  samplingPlan     SamplingPlan?
  custodyEntry     CustodyEntry?
  sampleAcceptance SampleAcceptance?
  resultWorksheet  ResultWorksheet?

  @@index([proposalId])
  @@index([collectionPointId])
  @@map("productive_processes")
}

// Ordem de Serviço: gerada a partir de um Processo Produtivo, com os
// parâmetros/ensaios efetivamente selecionados (e a quantidade que será
// realizada) entre os que já estão vinculados ao ponto de coleta/proposta
// de origem — nunca uma lista independente de parâmetros. Um mesmo
// Processo Produtivo pode gerar mais de uma Ordem de Serviço.
model ServiceOrder {
  id                  String @id @default(cuid())
  code                String @unique // ex: "OS 001/2026_1"
  sequenceInProcess   Int // 1, 2, 3... dentro do mesmo Processo Produtivo
  productiveProcessId String

  createdById String
  createdAt   DateTime @default(now())

  productiveProcess ProductiveProcess  @relation(fields: [productiveProcessId], references: [id])
  createdBy         User               @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id])
  items             ServiceOrderItem[]

  @@unique([productiveProcessId, sequenceInProcess])
  @@index([productiveProcessId])
  @@map("service_orders")
}

// Item da Ordem de Serviço: referencia o ProposalTest já existente (que já
// carrega ensaio/método/unidade/código/valor na proposta), evitando
// duplicar esses dados — só a quantidade efetivamente selecionada para
// realização é própria da Ordem de Serviço.
model ServiceOrderItem {
  id             String @id @default(cuid())
  serviceOrderId String
  proposalTestId String
  quantity       Int

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  proposalTest ProposalTest @relation(fields: [proposalTestId], references: [id])

  @@index([serviceOrderId])
  @@map("service_order_items")
}

// =========================================================================
// CAMPANHA DE MONITORAMENTO — EXECUÇÃO TÉCNICA (ISO/IEC 17025)
// =========================================================================
// As 4 fases do ciclo de vida técnico (Plano de Amostragem, Entrada e
// Custódia, Checagem/Aceitação, Resultados) penduram 1:1 em
// ProductiveProcess, que já é o "item de execução" por ponto/matriz. A aba
// por matriz na tela da proposta é apenas um agrupamento visual dos
// ProductiveProcess daquela proposta por collectionPoint.matrix — não
// precisa de uma tabela própria.

// Catálogo de equipamentos reutilizável (sonômetros, bombas, etc.), com
// validade de calibração (RBC) para apoiar a auditoria da ISO 17025.
model Equipment {
  id                     String    @id @default(cuid())
  name                   String
  serialNumber           String?
  calibrationCertificate String?
  calibrationValidUntil  DateTime?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  samplingPlanChecks SamplingPlanEquipment[]

  @@map("equipment")
}

// Fase 1 — Plano de Amostragem (ISO 7.3): agendamento da coleta/medição em
// campo e checklist de equipamentos necessários. Os pontos monitorados já
// são os do próprio ProductiveProcess (1 ponto por processo) — não há
// seleção de ponto aqui, pois o ponto já foi definido na proposta.
model SamplingPlan {
  id                  String   @id @default(cuid())
  productiveProcessId String   @unique
  scheduledAt         DateTime
  fieldResponsibleId  String
  notes               String?
  createdById         String
  createdAt           DateTime @default(now())

  productiveProcess ProductiveProcess       @relation(fields: [productiveProcessId], references: [id])
  fieldResponsible  User                    @relation("SamplingPlanFieldResponsible", fields: [fieldResponsibleId], references: [id])
  createdBy         User                    @relation("SamplingPlanCreatedBy", fields: [createdById], references: [id])
  equipmentChecks   SamplingPlanEquipment[]

  @@map("sampling_plans")
}

// Snapshot da validade de calibração no momento do uso — alterar a
// calibração do equipamento depois nunca altera um plano já registrado
// (mesmo padrão de snapshot usado em ProposalTest/EpiOrderItem).
model SamplingPlanEquipment {
  id                            String    @id @default(cuid())
  samplingPlanId                String
  equipmentId                   String
  calibrationValidUntilSnapshot DateTime?

  samplingPlan SamplingPlan @relation(fields: [samplingPlanId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id])

  @@index([samplingPlanId])
  @@map("sampling_plan_equipment")
}

// Fase 2 — Entrada e Custódia (ISO 7.4): chegada ao laboratório (ou
// conclusão da medição in situ), responsável pela coleta/transporte e
// condições climáticas de campo registradas.
model CustodyEntry {
  id                  String   @id @default(cuid())
  productiveProcessId String   @unique
  arrivedAt           DateTime
  receivedById        String
  weatherConditions   String?
  temperatureC        Decimal? @db.Decimal(5, 2)
  humidityPercent     Decimal? @db.Decimal(5, 2)
  createdAt           DateTime @default(now())

  productiveProcess ProductiveProcess @relation(fields: [productiveProcessId], references: [id])
  receivedBy        User              @relation(fields: [receivedById], references: [id])

  @@map("custody_entries")
}

enum AcceptanceStatus {
  ACEITA
  ACEITA_COM_RESSALVAS
  REJEITADA
}

// Fase 3 — Checagem e Aceitação (ISO 7.4): critérios de aceitação
// (integridade de filtros, soluções absorvedoras, lacres) e registro de
// anomalias/desvios quando rejeitada ou aceita com ressalvas.
model SampleAcceptance {
  id                  String           @id @default(cuid())
  productiveProcessId String           @unique
  status              AcceptanceStatus
  filtersIntegrityOk  Boolean          @default(true)
  sealsIntegrityOk    Boolean          @default(true)
  absorbentSolutionOk Boolean          @default(true)
  deviationNotes      String?
  acceptedById        String
  acceptedAt          DateTime         @default(now())

  productiveProcess ProductiveProcess @relation(fields: [productiveProcessId], references: [id])
  acceptedBy        User              @relation(fields: [acceptedById], references: [id])

  @@map("sample_acceptances")
}

// Fase 4 — Resultados (Folha de Trabalho / Worksheet). Base comum +
// detalhe específico por matriz (gravimetria para EA/QAR, leituras
// acústicas para RA) — mesmo padrão de base+detalhe por matriz já usado em
// CollectionPoint (AirQuality/AtmosphericEmission/Noise).
model ResultWorksheet {
  id                  String    @id @default(cuid())
  productiveProcessId String    @unique
  analyzedById        String?
  analyzedAt          DateTime?
  validatedById       String?
  validatedAt         DateTime?

  productiveProcess ProductiveProcess @relation(fields: [productiveProcessId], references: [id])
  analyzedBy        User?             @relation("ResultWorksheetAnalyzedBy", fields: [analyzedById], references: [id])
  validatedBy       User?             @relation("ResultWorksheetValidatedBy", fields: [validatedById], references: [id])

  gravimetry ResultWorksheetGravimetry?
  acoustic   ResultWorksheetAcoustic?

  @@map("result_worksheets")
}

// Detalhe EA/QAR: pesagem de filtros (gravimetria), branco de campo e
// leitura de laboratório.
model ResultWorksheetGravimetry {
  resultWorksheetId  String   @id
  filterWeightBefore Decimal? @db.Decimal(10, 4)
  filterWeightAfter  Decimal? @db.Decimal(10, 4)
  fieldBlankWeight   Decimal? @db.Decimal(10, 4)
  labReadingValue    Decimal? @db.Decimal(12, 4)
  sampledVolumeM3    Decimal? @db.Decimal(10, 4)

  resultWorksheet ResultWorksheet @relation(fields: [resultWorksheetId], references: [id])

  @@map("result_worksheet_gravimetry")
}

// Detalhe RA: medições diretas de dB(A) (L90, Leq, L10) e ruído de fundo.
model ResultWorksheetAcoustic {
  resultWorksheetId  String   @id
  leqDba             Decimal? @db.Decimal(6, 2)
  l10Dba             Decimal? @db.Decimal(6, 2)
  l90Dba             Decimal? @db.Decimal(6, 2)
  backgroundNoiseDba Decimal? @db.Decimal(6, 2)
  measurementMinutes Int?

  resultWorksheet ResultWorksheet @relation(fields: [resultWorksheetId], references: [id])

  @@map("result_worksheet_acoustic")
}

// =========================================================================
// AUDITORIA
// =========================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String // ex: "CREATE", "UPDATE", "STATUS_CHANGE", "DELETE"
  entityType  String // ex: "Client", "Proposal"
  entityId    String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
