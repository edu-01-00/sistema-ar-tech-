# Banco de dados PostgreSQL
DATABASE_URL="postgresql://labapp:labapp_dev_pw@localhost:5432/lab_management?schema=public"

# NextAuth
# Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Armazenamento de documentos (implementação local em disco por padrão).
# Pode ser trocado por um provedor externo (S3, Supabase Storage, etc.)
# implementando a interface em src/lib/storage.ts.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Caminho do executável do Chromium/Chrome instalado localmente, usado para
# gerar PDFs (propostas e ordens de serviço de EPI) em desenvolvimento.
# Obrigatório em ambiente local. Em produção na Vercel isso NÃO é necessário
# — o Chromium é resolvido automaticamente via @sparticuz/chromium.
PDF_CHROMIUM_EXECUTABLE_PATH=""
